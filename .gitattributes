# Normalize line endings: LF in the repo and in the working tree (CI and Docker run on Linux).
* text=auto eol=lf
# The Maven wrapper script must keep LF or it fails on Linux.
/mvnw text eol=lf
# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
# Binaries
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary

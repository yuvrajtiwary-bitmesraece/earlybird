# EarlyBird configuration. Copy to .env and fill in. Never commit real values.
# Full reference: docs/earlybird-spec.md, section 5.
# Keep comments on their own lines: this file is read as Java properties,
# where a trailing "# ..." would become part of the value.

# ---------- Runtime ----------
# local | prod. Production must set this to prod as a real environment variable.
# Locally it can stay unset: the local profile is the default, and it is what reads this file.
SPRING_PROFILES_ACTIVE=local
# dev | prod (used as the Redis key prefix)
EARLYBIRD_ENV=dev
EARLYBIRD_ROLES=web,bot,poller,enricher,matcher,notifier,scheduler
# Render sets PORT in production
PORT=8080
# prod: https://<service>.onrender.com
PUBLIC_BASE_URL=http://localhost:8080

# ---------- PostgreSQL (Supabase session pooler, port 5432) ----------
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=
# local: earlybird_dev | prod: earlybird
DB_SCHEMA=earlybird_dev

# ---------- Redis (Upstash). Empty means in-memory fallbacks ----------
# rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# ---------- Event bus ----------
# memory (local default) | kafka (production)
EVENT_BUS=memory
# Aiven: the service's "Service URI", host:port, without quotes.
KAFKA_BOOTSTRAP_SERVERS=
# SSL (Aiven's client certificates) | SASL_SSL | PLAINTEXT (local test brokers only, refused in prod)
KAFKA_SECURITY_PROTOCOL=SSL
# PEM text on one line, with each newline written as backslash-n. Don't paste it by hand: download Aiven's CA
# certificate, access certificate and access key into a folder, then run:
#   java scripts/KafkaPemsToEnv.java <that folder>
KAFKA_SSL_CA_PEM=
KAFKA_SSL_CERT_PEM=
KAFKA_SSL_KEY_PEM=
# Only for SASL_SSL: SCRAM-SHA-256 | SCRAM-SHA-512 | PLAIN
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_PREFIX=eb.

# ---------- Telegram (dev and prod are different bots) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# polling (local) | webhook (prod)
TELEGRAM_MODE=polling
# random, 32+ chars; only used in webhook mode
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_CHAT_ID=
TELEGRAM_GLOBAL_RATE_PER_SEC=25

# ---------- Gemini ----------
GEMINI_API_KEY=
# a Flash-Lite model id confirmed against the live model list
GEMINI_MODEL=
GEMINI_MAX_CALLS_PER_DAY=400

# ---------- Scheduling ----------
# internal (local, Spring @Scheduled) | external (prod, QStash)
SCHEDULER_MODE=internal
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
ADAPTIVE_SCHEDULING=false

# ---------- Alerts ----------
ALERT_DEFAULT_MIN_SCORE=55
ALERT_DEFAULT_DAILY_CAP=10
# optional; empty hides the "Prep for this job" button
PREP_LINK_TEMPLATE=

# ---------- Observability ----------
# protects /actuator/prometheus
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
